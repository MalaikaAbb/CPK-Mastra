# Copy to frontend/.env.local and fill in.
# Never commit the filled-in file.
#
# Note there is only one .env here. Mastra is TypeScript and its agents run
# inside the Next.js process, so there is no separate agent server to configure.

# ── Required ────────────────────────────────────────────────────────────────

# Model provider key. Read by the Mastra agents, which run server-side inside
# the Next app — it is never exposed to the browser.
OPENAI_API_KEY=sk-...


# ── Optional ────────────────────────────────────────────────────────────────

# Model for every agent. The docs specify four different ids across the pages
# this repo implements (gpt-5.4, gpt-5.4-mini, gpt-4o, gpt-4.1), so all agents
# read this instead. Defaults to gpt-4o.
# OPENAI_MODEL=gpt-4o

# CopilotKit Intelligence project API key (server-only). Only the Threads Drawer
# route uses it, on its own runtime (/api/copilotkit-threads). Get one with
# `npx copilotkit@latest project select`. Unset, that route shows the drawer's
# locked view.
# CPK_INTELLIGENCE_API_KEY=cpk-...

# CopilotKit Enterprise Intelligence public license key (browser-safe).
# Not needed by any route in this repo.
# NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=ck_pub_...
